# Copy to .env next to your Immich docker-compose.yml. Never commit the real file.

# From Immich: avatar -> Account Settings -> API Keys.
# Stays on the host. It is never sent to a client and never leaves the machine.
IMMICH_API_KEY=

# The secret a client must present to this server. Anything long and random.
# PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# bash:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-48
MCP_BEARER_TOKEN=

# Optional. Named in the "Immich is unreachable" message so the model can tell
# its user which machine to go and switch on. Leave blank for generic wording.
IMMICH_HOST_HINT=

# Optional. 'read' (default) registers only read tools; 'full' adds upload,
# create-album and add-to-album. Neither mode registers anything that deletes.
MCP_MODE=read

# Optional, default off. Also accept ?token=... on the URL, for clients that
# cannot set a custom header. Query strings land in proxy and server logs;
# leave this off unless the alternative is not shipping at all.
MCP_ALLOW_QUERY_TOKEN=
